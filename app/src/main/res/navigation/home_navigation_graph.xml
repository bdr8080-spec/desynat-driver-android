<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_navigation_graph"
    app:startDestination="@id/home">

    <fragment
        android:id="@+id/home"
        android:name="com.desynatdriver.ui.home.fragment.HomeFragment"
        android:label="Home Fragment"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_homeFragment_to_newOrderFragment"
            app:destination="@id/newOrder" />

        <action
            android:id="@+id/action_homeFragment_to_deliveryDetailFragment"
            app:destination="@id/deliveryDetail" />

        <action
            android:id="@+id/action_homeFragment_to_notificationFragment"
            app:destination="@id/notification" />

        <action
            android:id="@+id/action_homeFragment_to_TidioChatFragment"
            app:destination="@id/tidioChat" />

    </fragment>

    <fragment
        android:id="@+id/deliveries"
        android:name="com.desynatdriver.ui.home.fragment.deliveries.DeliveriesFragment"
        android:label="Deliveries Fragment"
        tools:layout="@layout/fragment_deliveries">

        <action
            android:id="@+id/action_deliveriesFragment_to_newOrderFragment"
            app:destination="@id/newOrder" />

        <action
            android:id="@+id/action_deliveriesFragment_to_deliveryDetailFragment"
            app:destination="@id/deliveryDetail" />

    </fragment>

    <fragment
        android:id="@+id/newOrder"
        android:name="com.desynatdriver.ui.home.fragment.deliveries.NewOrderFragment"
        android:label="New Order Fragment"
        tools:layout="@layout/fragment_new_order"/>

    <fragment
        android:id="@+id/deliveryDetail"
        android:name="com.desynatdriver.ui.home.fragment.deliveries.DeliveryDetailFragment"
        android:label="Delivery Detail Fragment"
        tools:layout="@layout/fragment_delivery_detail"/>

    <fragment
        android:id="@+id/profile"
        android:name="com.desynatdriver.ui.home.fragment.ProfileFragment"
        android:label="Profile Fragment"
        tools:layout="@layout/fragment_profile">

        <action
            android:id="@+id/action_profileFragment_to_editProfileFragment"
            app:destination="@id/editProfile" />

    </fragment>

    <fragment
        android:id="@+id/editProfile"
        android:name="com.desynatdriver.ui.home.fragment.EditProfileFragment"
        android:label="Edit Profile Fragment"
        tools:layout="@layout/fragment_edit_profile"/>

    <fragment
        android:id="@+id/notification"
        android:name="com.desynatdriver.ui.home.fragment.NotificationFragment"
        android:label="Notification Fragment"
        tools:layout="@layout/fragment_notification"/>


    <fragment
        android:id="@+id/support"
        android:name="com.desynatdriver.ui.home.cms.SupportFragment"
        android:label="Support Fragment"
        tools:layout="@layout/fragment_support">

        <action
            android:id="@+id/action_supportFragment_to_ticketDetailFragment"
            app:destination="@id/ticketDetail"/>
        <action
            android:id="@+id/action_supportFragment_to_tidioChatFragment"
            app:destination="@id/tidioChat"/>

    </fragment>

    <fragment
        android:id="@+id/tidioChat"
        android:name="com.desynatdriver.ui.home.cms.TidioChatFragment"
        android:label="Tidio Chat Fragment"
        tools:layout="@layout/fragment_tidio_chat"/>


    <fragment
        android:id="@+id/setting"
        android:name="com.desynatdriver.ui.home.cms.SettingFragment"
        android:label="Setting Fragment"
        tools:layout="@layout/fragment_setting"/>

    <fragment
        android:id="@+id/faq"
        android:name="com.desynatdriver.ui.home.cms.FaqFragment"
        android:label="Faq Fragment"
        tools:layout="@layout/fragment_faq"/>

    <fragment
        android:id="@+id/ticketDetail"
        android:name="com.desynatdriver.ui.home.cms.TicketDetailFragment"
        android:label="Ticket Detail Fragment"
        tools:layout="@layout/fragment_ticket_detail"/>

    <fragment
        android:id="@+id/changeLanguageFragment"
        android:name="com.desynatdriver.ui.home.cms.ChangeLanguageFragment"
        android:label="Change Language Fragment"
        tools:layout="@layout/fragment_change_language"/>

    <fragment
        android:id="@+id/supportChat"
        android:name="com.desynatdriver.ui.home.cms.SupportChatFragment"
        android:label="Support Chat Fragment"
        tools:layout="@layout/fragment_support_chat"/>

</navigation>