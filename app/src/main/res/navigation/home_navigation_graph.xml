<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_navigation_graph"
    app:startDestination="@id/home">

    <fragment
        android:id="@+id/home"
        android:name="com.desynatdriver.ui.home.fragment.HomeFragment"
        android:label="Home Fragment"
        tools:layout="@layout/fragment_home"/>

    <fragment
        android:id="@+id/deliveries"
        android:name="com.desynatdriver.ui.home.fragment.deliveries.DeliveriesFragment"
        android:label="Deliveries Fragment"
        tools:layout="@layout/fragment_deliveries"/>

    <fragment
        android:id="@+id/profile"
        android:name="com.desynatdriver.ui.home.fragment.ProfileFragment"
        android:label="Profile Fragment"
        tools:layout="@layout/fragment_profile">

        <action
            android:id="@+id/action_profileFragment_to_editProfileFragment"
            app:destination="@id/editProfile" />

    </fragment>

    <fragment
        android:id="@+id/editProfile"
        android:name="com.desynatdriver.ui.home.fragment.EditProfileFragment"
        android:label="Edit Profile Fragment"
        tools:layout="@layout/fragment_edit_profile"/>

</navigation>