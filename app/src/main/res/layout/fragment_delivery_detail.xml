<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    tools:context=".ui.home.fragment.deliveries.DeliveryDetailFragment">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_back"
        android:padding="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_30sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_medium"
        android:text="@string/detail"
        android:textColor="@color/black"
        android:textSize="@dimen/_13sdp"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivBack"
        app:layout_constraintBottom_toBottomOf="@+id/ivBack"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_medium"
        android:text="@string/delivered"
        android:textColor="#17854C"
        android:textSize="@dimen/_12sdp"
        android:textAlignment="center"
        android:layout_marginEnd="@dimen/_15sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivBack"
        app:layout_constraintBottom_toBottomOf="@+id/ivBack"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/ivBack"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_15sdp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDeliveryId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:text="@string/delivered_id"
                android:textColor="#CC000000"
                android:textSize="@dimen/_11sdp"
                android:textAlignment="center"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDeliveryIdValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="#672828"
                android:textColor="@color/black"
                android:textSize="@dimen/_11sdp"
                android:textAlignment="textEnd"
                app:layout_constraintStart_toEndOf="@+id/tvDeliveryId"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvDeliveryId"
                app:layout_constraintBottom_toBottomOf="@+id/tvDeliveryId"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDeliveryOn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:layout_marginTop="@dimen/_5sdp"
                android:text="@string/delivered_on"
                android:textColor="#CC000000"
                android:textSize="@dimen/_11sdp"
                android:textAlignment="center"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvDeliveryId"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDeliveryOnValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="22/02/25 at 08:00PM"
                android:textColor="@color/black"
                android:textSize="@dimen/_11sdp"
                android:textAlignment="textEnd"
                app:layout_constraintStart_toEndOf="@+id/tvDeliveryOn"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvDeliveryOn"
                app:layout_constraintBottom_toBottomOf="@+id/tvDeliveryOn"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clPickUp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:padding="@dimen/_10sdp"
                app:layout_constraintTop_toBottomOf="@+id/tvDeliveryOn"
                android:background="@drawable/card_stroke_background">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivPickup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_pickup"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvPickupFrom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/pick_up_from"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11sdp"
                    android:textAlignment="center"
                    android:layout_marginStart="@dimen/_10sdp"
                    app:layout_constraintTop_toTopOf="@+id/ivPickup"
                    app:layout_constraintStart_toEndOf="@+id/ivPickup"
                    app:layout_constraintBottom_toBottomOf="@+id/ivPickup"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvPickupAddress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:text="4th Floor, A/129, Sun Apartment, Sector 63, Kuwait"
                    android:textColor="#80000000"
                    android:textSize="@dimen/_10sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvPickupFrom"
                    app:layout_constraintStart_toStartOf="@+id/tvPickupFrom"/>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivImage"
                    android:layout_width="@dimen/_35sdp"
                    android:layout_height="@dimen/_35sdp"
                    android:src="@drawable/ic_user"
                    android:scaleType="centerCrop"
                    android:clipToOutline="true"
                    android:layout_marginTop="@dimen/_10sdp"
                    app:shapeAppearanceOverlay="@style/circle_image"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvPickupAddress"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/mathew_kerry"
                    android:textSize="@dimen/_10sdp"
                    android:textColor="#1A1C1E"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:layout_marginStart="@dimen/_10sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/ivImage"
                    app:layout_constraintTop_toTopOf="@+id/ivImage"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvRating"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="0"
                    android:textSize="@dimen/_10sdp"
                    android:textColor="#1A1C1E"
                    android:layout_marginTop="@dimen/_4sdp"
                    app:layout_constraintTop_toBottomOf="@+id/tvName"
                    app:layout_constraintStart_toStartOf="@+id/tvName"/>

                <androidx.appcompat.widget.AppCompatRatingBar
                    android:id="@+id/rbStore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_2sdp"
                    app:layout_constraintStart_toEndOf="@+id/tvRating"
                    app:layout_constraintTop_toBottomOf="@+id/tvName"                    app:layout_constraintBottom_toBottomOf="@+id/tvRating"
                    android:numStars="5"
                    android:rating="0"
                    android:progressTint="#FFCE1B"
                    style="@style/Widget.AppCompat.RatingBar.Small"/>


            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clDrop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:padding="@dimen/_10sdp"
                app:layout_constraintTop_toBottomOf="@+id/clPickUp"
                android:background="@drawable/card_stroke_background">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivDrop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_drop"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvDrop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/drop_location"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11sdp"
                    android:textAlignment="center"
                    android:layout_marginStart="@dimen/_10sdp"
                    app:layout_constraintTop_toTopOf="@+id/ivDrop"
                    app:layout_constraintStart_toEndOf="@+id/ivDrop"
                    app:layout_constraintBottom_toBottomOf="@+id/ivDrop"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvDropAddress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:text="4th Floor, A/129, Sun Apartment, Sector 63, Kuwait"
                    android:textColor="#80000000"
                    android:textSize="@dimen/_10sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvDrop"
                    app:layout_constraintStart_toStartOf="@+id/tvDrop"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvCustomer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:text="@string/customer_name"
                    android:textColor="#CC000000"
                    android:textSize="@dimen/_11sdp"
                    android:textAlignment="center"
                    android:layout_marginTop="@dimen/_5sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvDropAddress"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvCustomerName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/atif_aslam"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11sdp"
                    android:textAlignment="textEnd"
                    app:layout_constraintStart_toEndOf="@+id/tvCustomer"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tvCustomer"
                    app:layout_constraintBottom_toBottomOf="@+id/tvCustomer"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvOrderDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:text="@string/order_date_amp_time"
                    android:textColor="#CC000000"
                    android:textSize="@dimen/_11sdp"
                    android:textAlignment="center"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvCustomer"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvOrderDateTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="22/02/25 at 08:00PM"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11sdp"
                    android:textAlignment="textEnd"
                    app:layout_constraintStart_toEndOf="@+id/tvOrderDate"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tvOrderDate"
                    app:layout_constraintBottom_toBottomOf="@+id/tvOrderDate"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvOrderId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:text="@string/order_id"
                    android:textColor="#CC000000"
                    android:textSize="@dimen/_11sdp"
                    android:textAlignment="center"
                    android:layout_marginTop="@dimen/_5sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvOrderDate"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvOrderIdValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="#672828"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11sdp"
                    android:textAlignment="textEnd"
                    app:layout_constraintStart_toEndOf="@+id/tvOrderId"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tvOrderId"
                    app:layout_constraintBottom_toBottomOf="@+id/tvOrderId"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:text="@string/price"
                    android:textColor="#CC000000"
                    android:textSize="@dimen/_11sdp"
                    android:textAlignment="center"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvOrderId"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvPriceValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="79.96 KD"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11sdp"
                    android:textAlignment="textEnd"
                    app:layout_constraintStart_toEndOf="@+id/tvPrice"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tvPrice"
                    app:layout_constraintBottom_toBottomOf="@+id/tvPrice"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvPaymentStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semi_bold"
                    android:text="@string/paid"
                    android:textColor="#17854C"
                    android:textSize="@dimen/_12sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvPriceValue"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvOrderDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/order_details"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sdp"
                android:layout_marginTop="@dimen/_15sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/clDrop"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clOrderDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_stroke_background"
                android:backgroundTint="#FFF7EA"
                android:padding="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_5sdp"
                app:layout_constraintTop_toBottomOf="@+id/tvOrderDetail">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivOrder"
                    android:layout_width="@dimen/_50sdp"
                    android:layout_height="@dimen/_50sdp"
                    android:src="@drawable/ic_placeholder"
                    android:scaleType="centerCrop"
                    android:clipToOutline="true"
                    app:shapeAppearanceOverlay="@style/rounded_corner_10sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvStore"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/nike_abaya"
                    android:textSize="@dimen/_11sdp"
                    android:textColor="@color/black"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:layout_marginStart="@dimen/_10sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/ivOrder"
                    app:layout_constraintTop_toTopOf="@+id/ivOrder"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:text="@string/size_m"
                    android:textSize="@dimen/_10sdp"
                    android:textColor="@color/black"
                    android:layout_marginBottom="@dimen/_15sdp"
                    app:layout_constraintStart_toStartOf="@+id/tvStore"
                    app:layout_constraintTop_toBottomOf="@+id/tvStore"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvColor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:text="@string/color"
                    android:textSize="@dimen/_10sdp"
                    android:textColor="@color/black"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:drawableStart="@drawable/ic_grey_dot"
                    android:drawablePadding="@dimen/_5sdp"
                    app:layout_constraintStart_toEndOf="@+id/tvSize"
                    app:layout_constraintBottom_toBottomOf="@+id/tvSize"
                    app:layout_constraintTop_toTopOf="@+id/tvSize"/>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivColor"
                    android:layout_width="@dimen/_10sdp"
                    android:layout_height="@dimen/_10sdp"
                    android:src="#98ADFF"
                    android:layout_marginStart="@dimen/_5sdp"
                    app:shapeAppearanceOverlay="@style/rounded_corner_2sdp"
                    app:layout_constraintStart_toEndOf="@+id/tvColor"
                    app:layout_constraintTop_toTopOf="@+id/tvColor"
                    app:layout_constraintBottom_toBottomOf="@id/tvColor"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvQuantity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/quantity"
                    android:textSize="@dimen/_11sdp"
                    android:textColor="#66635E"
                    android:layout_marginBottom="@dimen/_15sdp"
                    app:layout_constraintStart_toStartOf="@+id/tvStore"
                    app:layout_constraintTop_toBottomOf="@+id/tvSize"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvQuantityValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="02"
                    android:textSize="@dimen/_11sdp"
                    android:textColor="@color/black"
                    android:layout_marginStart="@dimen/_10sdp"
                    app:layout_constraintStart_toEndOf="@+id/tvQuantity"
                    app:layout_constraintBottom_toBottomOf="@+id/tvQuantity"
                    app:layout_constraintTop_toTopOf="@+id/tvQuantity"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:visibility="gone"
                android:id="@+id/tvDeliveryInstruction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/delivery_instruction"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sdp"
                android:layout_marginTop="@dimen/_15sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/clOrderDetail"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:visibility="gone"
                android:id="@+id/tvDeliveryInstructionValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:text="Lorem ipsum dolor sit amet, consum adipiscing elit, sed do eiusmod tempor incididunt ut dolore magna tempor incididunt ut dolore magnaaliqua."
                android:textColor="@color/black"
                android:textSize="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_5sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvDeliveryInstruction"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:visibility="gone"
                android:id="@+id/tvReason"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/reason_for_not_delivered"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sdp"
                android:layout_marginTop="@dimen/_15sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvDeliveryInstructionValue"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:visibility="gone"
                android:id="@+id/tvReasonForNotDelivered"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:text="Lorem ipsum dolor sit amet, consum adipiscing elit, sed do eiusmod tempor incididunt ut dolore magna tempor incididunt ut dolore magnaaliqua."
                android:textColor="@color/black"
                android:textSize="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_5sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvReason"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvTotalDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/total_distance"
                android:textColor="#666666"
                android:textSize="@dimen/_12sdp"
                android:layout_marginTop="@dimen/_15sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvReasonForNotDelivered"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvTotalDistanceValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semi_bold"
                android:text="7.5 Km"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sdp"
                app:layout_constraintTop_toTopOf="@+id/tvTotalDistance"
                app:layout_constraintBottom_toBottomOf="@+id/tvTotalDistance"
                app:layout_constraintEnd_toEndOf="parent"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                app:layout_constraintTop_toBottomOf="@+id/tvTotalDistance"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>