<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_pink"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.home.fragment.HomeFragment">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_menu"
        android:layout_marginTop="@dimen/_30sdp"
        android:paddingVertical="@dimen/_15sdp"
        android:paddingHorizontal="@dimen/_15sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="On Duty"
        android:textColor="@color/black"
        android:textSize="@dimen/_10sdp"
        android:gravity="center"
        android:fontFamily="@font/poppins_medium"
        android:drawablePadding="@dimen/_10sdp"
        android:drawableEnd="@drawable/switch_on"
        android:layout_marginEnd="@dimen/_15sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
       app:layout_constraintTop_toTopOf="@+id/ivMenu"
        app:layout_constraintBottom_toBottomOf="@+id/ivMenu"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivNotification"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/notification_icon"
        android:paddingVertical="@dimen/_15sdp"
        android:paddingHorizontal="@dimen/_15sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivMenu"
        app:layout_constraintBottom_toBottomOf="@+id/ivMenu"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/ivMenu"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFF7EA">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvChooseDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_15sdp"
                    android:layout_marginTop="15dp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Choose date"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etFrom"
                    style="@style/edit_text"
                    android:layout_width="0dp"
                    android:paddingVertical="@dimen/_9sdp"
                    android:drawablePadding="@dimen/_5sdp"
                    android:hint="From   //  //"
                    android:editable="false"
                    android:clickable="true"
                    android:background="@drawable/card_stroke_filled_background"
                    android:focusable="false"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="@dimen/_15sdp"
                    android:layout_centerVertical="true"
                    android:textColorHint="@color/black"
                    android:drawableEnd="@drawable/ic_calendar"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/etTo"
                    app:layout_constraintTop_toBottomOf="@+id/tvChooseDate"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etTo"
                    style="@style/edit_text"
                    android:layout_width="0dp"
                    android:paddingVertical="@dimen/_9sdp"
                    android:drawablePadding="@dimen/_5sdp"
                    android:hint="To   //  //"
                    android:editable="false"
                    android:clickable="true"
                    android:background="@drawable/card_stroke_filled_background"
                    android:focusable="false"
                    android:textColorHint="@color/black"
                    android:layout_marginEnd="@dimen/_15sdp"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_centerVertical="true"
                    android:drawableEnd="@drawable/ic_calendar"
                    app:layout_constraintStart_toEndOf="@+id/etFrom"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="@+id/etFrom"
                    app:layout_constraintTop_toTopOf="@+id/etFrom"/>

                <RadioGroup
                    android:id="@+id/radioGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="3"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:orientation="horizontal"
                    android:layout_marginHorizontal="@dimen/_15sdp"
                    app:layout_constraintTop_toBottomOf="@+id/etFrom">

                    <RadioButton
                        android:id="@+id/rbToday"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Today"
                        android:layout_weight="1"
                        android:textColor="@color/black"
                        android:paddingVertical="@dimen/_12sdp"
                        android:button="@drawable/selector_home_radio_icon"
                        android:paddingStart="@dimen/_8sdp"
                        android:checked="true"
                        app:buttonTint="@null"
                        android:drawableTint="@null"
                        android:fontFamily="@font/poppins_medium"
                        android:textSize="@dimen/_11sdp"/>

                    <RadioButton
                        android:id="@+id/rbWeek"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="This Week"
                        android:layout_weight="1"
                        android:textColor="@color/black"
                        android:paddingVertical="@dimen/_12sdp"
                        android:button="@drawable/selector_home_radio_icon"
                        android:paddingStart="@dimen/_8sdp"
                        android:checked="false"
                        app:buttonTint="@null"
                        android:drawableTint="@null"
                        android:fontFamily="@font/poppins_medium"
                        android:textSize="@dimen/_11sdp"/>

                    <RadioButton
                        android:id="@+id/rbMonth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="This Month"
                        android:textColor="@color/black"
                        android:paddingVertical="@dimen/_12sdp"
                        android:button="@drawable/selector_home_radio_icon"
                        android:paddingStart="@dimen/_8sdp"
                        android:checked="false"
                        app:buttonTint="@null"
                        android:drawableTint="@null"
                        android:fontFamily="@font/poppins_medium"
                        android:textSize="@dimen/_11sdp"/>

                </RadioGroup>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/radioGroup"
                android:background="@color/white">

                <androidx.cardview.widget.CardView
                    android:id="@+id/clNewDeliveries"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:layout_marginStart="@dimen/_15sdp"
                    android:layout_marginEnd="@dimen/_6sdp"
                    app:cardCornerRadius="@dimen/_10sdp"
                    app:cardElevation="1dp"
                   app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvNewDelivery"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:text="New Deliveries"
                            android:textSize="@dimen/_16sdp"
                            android:textColor="@color/black"
                            android:layout_marginStart="@dimen/_15sdp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvNewDeliveries"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semi_bold"
                            android:text="120"
                            android:textColor="@color/black"
                            android:layout_marginTop="@dimen/_8sdp"
                            android:textSize="@dimen/_18sdp"
                            app:layout_constraintStart_toStartOf="@+id/tvNewDelivery"
                            app:layout_constraintTop_toBottomOf="@+id/tvNewDelivery"/>

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_new_delivery"
                            android:layout_marginEnd="@dimen/_10sdp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/clOngoing"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/card_stroke_background"
                    android:layout_marginStart="@dimen/_15sdp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintEnd_toStartOf="@+id/clCompleted"
                    app:layout_constraintTop_toTopOf="@+id/clCompleted"
                    app:layout_constraintBottom_toBottomOf="@+id/clCompleted"
                    app:layout_constraintStart_toStartOf="parent"
                    app:cardElevation="1dp"
                    app:cardCornerRadius="@dimen/_10sdp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvOngoing"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:text="On Going Deliveries"
                            android:textSize="@dimen/_12sdp"
                            android:textColor="@color/black"
                            android:layout_marginStart="@dimen/_10sdp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvOngoingDeliveries"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semi_bold"
                            android:text="120"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_18sdp"
                            app:layout_constraintStart_toStartOf="@+id/tvOngoing"
                            app:layout_constraintBottom_toBottomOf="parent"/>

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_new_delivery"
                            android:layout_marginEnd="@dimen/_10sdp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tvOngoing"
                            app:layout_constraintBottom_toBottomOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/clCompleted"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_stroke_background"
                    android:layout_marginEnd="@dimen/_15sdp"
                    android:layout_marginStart="8dp"
                    app:layout_constraintStart_toEndOf="@+id/clOngoing"
                    app:layout_constraintTop_toBottomOf="@+id/clNewDeliveries"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginTop="@dimen/_15sdp"
                    app:cardElevation="1dp"
                    app:cardCornerRadius="@dimen/_10sdp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvCompleted"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:text="Total Deliveries Completed"
                            android:textSize="@dimen/_12sdp"
                            android:textColor="@color/black"
                            android:layout_marginStart="@dimen/_15sdp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvCompletedDeliveries"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semi_bold"
                            android:text="120"
                            android:textColor="@color/black"
                            android:layout_marginTop="@dimen/_8sdp"
                            android:textSize="@dimen/_18sdp"
                            app:layout_constraintStart_toStartOf="@+id/tvCompleted"
                            app:layout_constraintTop_toBottomOf="@+id/tvCompleted"/>

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_completed_deliveries"
                            android:layout_marginEnd="@dimen/_10sdp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tvCompleted"
                            app:layout_constraintBottom_toBottomOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.cardview.widget.CardView>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/home_card"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:paddingBottom="@dimen/_15sdp"
                    app:layout_constraintTop_toBottomOf="@+id/clCompleted">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvNewDeliveriesTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:layout_marginTop="@dimen/_15sdp"
                        android:text="New Deliveries"
                        android:textSize="@dimen/_13sdp"
                        android:textColor="@color/black"
                        android:layout_marginStart="@dimen/_15sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/viewAllNewDeliveries"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_regular"
                        android:paddingTop="@dimen/_15sdp"
                        android:text="View All"
                        android:textSize="@dimen/_11sdp"
                        android:textColor="@color/black"
                        android:paddingEnd="@dimen/_15sdp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvNewDeliveries"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        android:orientation="horizontal"
                        tools:listitem="@layout/item_deliveries"
                        app:layout_constraintTop_toBottomOf="@+id/tvNewDeliveriesTitle"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvOngoingDeliveriesTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:layout_marginTop="@dimen/_15sdp"
                        android:text="Ongoing Deliveries"
                        android:textSize="@dimen/_13sdp"
                        android:textColor="@color/black"
                        android:layout_marginStart="@dimen/_15sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/rvNewDeliveries"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/viewAllOngoingDeliveries"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_regular"
                        android:paddingTop="@dimen/_15sdp"
                        android:text="View All"
                        android:textSize="@dimen/_11sdp"
                        android:textColor="@color/black"
                        android:paddingEnd="@dimen/_15sdp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/rvNewDeliveries"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvOngoingDeliveries"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        android:orientation="horizontal"
                        tools:listitem="@layout/item_deliveries"
                        app:layout_constraintTop_toBottomOf="@+id/tvOngoingDeliveriesTitle"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_60sdp"
                       app:layout_constraintTop_toBottomOf="@+id/rvOngoingDeliveries"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivSupportBot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_support_bot"
        android:layout_marginBottom="@dimen/_20sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>