<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/_15sdp"
    tools:context=".ui.auth.fragment.LanguageFragment">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:text="@string/select_language"
            android:layout_marginTop="@dimen/_30sdp"
            android:textColor="@color/black"
            android:textSize="@dimen/_13sdp"
            android:layout_gravity="center_horizontal"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            android:fontFamily="@font/poppins_medium"
            android:text="@string/choose_the_language_and_continue_to_get_the_experience_the_app_in_your_preferred_language"
            android:textColor="#80000000"
            android:textSize="@dimen/_10sdp"/>

    <RelativeLayout
        android:id="@+id/relEnglish"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20sdp"
        android:background="@drawable/edit_back">

        <CheckBox
            android:id="@+id/cbEnglish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/english"
            android:textColor="@color/black"
            android:paddingVertical="@dimen/_12sdp"
            android:button="@drawable/selector_radio_icon"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:paddingStart="@dimen/_8sdp"
            android:checked="false"
            app:buttonTint="@null"
            android:drawableTint="@null"
            android:textAlignment="viewStart"
            android:fontFamily="@font/poppins_medium"
            android:textSize="@dimen/_12sdp"/>

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/relArabic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20sdp"
        android:background="@drawable/edit_back">

        <CheckBox
            android:id="@+id/cbArabic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/arabic"
            android:textColor="@color/black"
            android:paddingVertical="@dimen/_12sdp"
            android:button="@drawable/selector_radio_icon"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:paddingStart="@dimen/_8sdp"
            android:checked="false"
            app:buttonTint="@null"
            android:drawableTint="@null"
            android:textAlignment="viewStart"
            android:fontFamily="@font/poppins_medium"
            android:textSize="@dimen/_12sdp"/>

    </RelativeLayout>


    <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btnContinue"
            style="@style/button"
            android:layout_marginTop="@dimen/_30sdp"
            android:layout_marginBottom="@dimen/_20sdp"
            android:text="@string/continue_text"/>

</LinearLayout>